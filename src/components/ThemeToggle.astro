---
import Icon from './Icon.astro';
---

<button
  type="button"
  class="btn btn--ghost btn--icon theme-toggle"
  data-theme-toggle
  aria-label="Switch to dark theme"
  title="Toggle theme"
>
  <Icon name="moon" class="theme-toggle__moon" />
  <Icon name="sun" class="theme-toggle__sun" />
</button>

<script>
  import { getTheme, toggleTheme, watchSystemTheme } from '@/lib/theme';

  const label = (theme: string) => `Switch to ${theme === 'dark' ? 'light' : 'dark'} theme`;

  for (const button of document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]')) {
    button.setAttribute('aria-label', label(getTheme()));
    button.addEventListener('click', () => {
      button.setAttribute('aria-label', label(toggleTheme()));
    });
  }
  watchSystemTheme();
</script>
