---
import { site } from '@/lib/site';

interface Props {
  /** Render as a plain span (e.g. inside the footer) instead of a home link. */
  static?: boolean;
}

const { static: isStatic = false } = Astro.props;
const Tag = isStatic ? 'span' : 'a';
---

<Tag
  class="logo"
  href={isStatic ? undefined : '/'}
  aria-label={isStatic ? undefined : `${site.name} home`}
>
  <svg
    class="logo__mark"
    xmlns="http://www.w3.org/2000/svg"
    viewBox="0 0 64 64"
    width="28"
    height="28"
    aria-hidden="true"
    focusable="false"
  >
    <rect width="64" height="64" rx="14" fill="#0b1220"></rect>
    <path
      d="M25 15c-5.5 0-8 2.5-8 8v4.5c0 3.2-1.8 5.2-5 5.5 3.2.3 5 2.3 5 5.5V43c0 5.5 2.5 8 8 8"
      fill="none"
      stroke="#38bdf8"
      stroke-width="4.5"
      stroke-linecap="round"
      stroke-linejoin="round"></path>
    <path
      d="M39 15c5.5 0 8 2.5 8 8v4.5c0 3.2 1.8 5.2 5 5.5-3.2.3-5 2.3-5 5.5V43c0 5.5-2.5 8-8 8"
      fill="none"
      stroke="#38bdf8"
      stroke-width="4.5"
      stroke-linecap="round"
      stroke-linejoin="round"></path>
    <path
      d="M36.5 20 27.5 44"
      fill="none"
      stroke="#f8fafc"
      stroke-width="4.5"
      stroke-linecap="round"></path>
  </svg>
  <span>{site.name}</span>
</Tag>
