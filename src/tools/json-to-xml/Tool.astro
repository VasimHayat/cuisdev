---
import Icon from '@/components/Icon.astro';

import './tool.scss';
---

<section
  class="tool tool-json-to-xml"
  data-tool="json-to-xml"
  aria-labelledby="json-to-xml-heading"
>
  <h2 id="json-to-xml-heading" class="visually-hidden">JSON and XML converter</h2>

  <div class="tool__options">
    <fieldset class="segmented" data-direction>
      <legend class="visually-hidden">Direction</legend>
      <label class="segmented__option">
        <input type="radio" name="direction" value="json-xml" checked />
        <span>JSON → XML</span>
      </label>
      <label class="segmented__option">
        <input type="radio" name="direction" value="xml-json" />
        <span>XML → JSON</span>
      </label>
    </fieldset>

    <label class="choice" data-only="json-xml">
      Root element
      <input
        type="text"
        class="field__input tool-json-to-xml__name"
        data-opt="root"
        value="root"
        placeholder="none"
        spellcheck="false"
        autocomplete="off"
        autocapitalize="off"
      />
    </label>

    <label class="choice">
      Indent
      <select class="field__select" data-opt="indent">
        <option value="2" selected>2 spaces</option>
        <option value="4">4 spaces</option>
      </select>
    </label>

    <label class="choice">
      Attribute prefix
      <input
        type="text"
        class="field__input tool-json-to-xml__prefix"
        data-opt="prefix"
        value="@_"
        placeholder="none"
        spellcheck="false"
        autocomplete="off"
        autocapitalize="off"
      />
    </label>

    <label class="choice" data-only="json-xml">
      <input type="checkbox" data-opt="declaration" checked />
      XML declaration
    </label>

    <label class="choice" data-only="xml-json" hidden>
      <input type="checkbox" data-opt="ignore-attributes" />
      Ignore attributes
    </label>

    <label class="choice" data-only="xml-json" hidden>
      <input type="checkbox" data-opt="parse-values" checked />
      Parse numbers and booleans
    </label>

    <label class="choice" data-only="xml-json" hidden>
      <input type="checkbox" data-opt="minify" />
      Minified JSON
    </label>
  </div>

  <div class="tool__panes">
    <div class="tool__pane">
      <div class="tool__pane-header">
        <label class="tool__pane-title" for="json-to-xml-input" data-input-label>JSON</label>
        <div class="tool__pane-actions">
          <button type="button" class="btn btn--ghost btn--sm" data-action="sample">
            <Icon name="play" /><span>Sample</span>
          </button>
          <button
            type="button"
            class="btn btn--ghost btn--sm"
            data-action="clear"
            aria-label="Clear input"
          >
            <Icon name="trash" /><span>Clear</span>
          </button>
        </div>
      </div>
      <textarea
        id="json-to-xml-input"
        class="field__textarea"
        placeholder="Paste JSON or XML here — the output updates as you type."
        spellcheck="false"
        autocomplete="off"
        autocapitalize="off"
        data-input></textarea>
      <div class="tool__stats" data-input-stats aria-live="off"></div>
    </div>

    <div class="tool__pane">
      <div class="tool__pane-header">
        <label class="tool__pane-title" for="json-to-xml-output" data-output-label>XML</label>
        <div class="tool__pane-actions">
          <button type="button" class="btn btn--ghost btn--sm" data-action="copy">
            <Icon name="copy" /><span data-label>Copy</span>
          </button>
          <button type="button" class="btn btn--ghost btn--sm" data-action="download">
            <Icon name="download" /><span>Download</span>
          </button>
        </div>
      </div>
      <textarea
        id="json-to-xml-output"
        class="field__textarea"
        placeholder="Output appears here"
        readonly
        spellcheck="false"
        data-output></textarea>
      <div class="tool__stats" data-output-stats aria-live="off"></div>
    </div>
  </div>

  <div class="tool__actions">
    <button type="button" class="btn" data-action="swap">
      <Icon name="swap" /><span>Swap: use output as input</span>
    </button>
    <p class="tool__status" role="status" aria-live="polite" data-status></p>
  </div>
</section>

<script>
  import './client';
</script>
