---
import Icon from '@/components/Icon.astro';

import './tool.scss';
---

<section
  class="tool tool-html-entity-encoder"
  data-tool="html-entity-encoder"
  aria-labelledby="html-entity-encoder-heading"
>
  <h2 id="html-entity-encoder-heading" class="visually-hidden">HTML entity encoder and decoder</h2>

  <div class="tool__options">
    <fieldset class="segmented" data-mode>
      <legend class="visually-hidden">Mode</legend>
      <label class="segmented__option">
        <input type="radio" name="entity-mode" value="encode" checked />
        <span>Encode</span>
      </label>
      <label class="segmented__option">
        <input type="radio" name="entity-mode" value="decode" />
        <span>Decode</span>
      </label>
    </fieldset>

    <label class="tool-html-entity-encoder__select" data-encode-only>
      <span>Encode</span>
      <select class="field__select" data-opt="level">
        <option value="essential" selected>Essential only (&amp; &lt; &gt; " ')</option>
        <option value="non-ascii">Non-ASCII + essential (named when possible)</option>
        <option value="decimal">All numeric (&amp;#NNN;)</option>
        <option value="hex">All hex (&amp;#xHH;)</option>
      </select>
    </label>
  </div>

  <div class="tool__panes">
    <div class="tool__pane">
      <div class="tool__pane-header">
        <label class="tool__pane-title" for="html-entity-encoder-input" data-input-label
          >Text to encode</label
        >
        <div class="tool__pane-actions">
          <button type="button" class="btn btn--ghost btn--sm" data-action="sample">
            <Icon name="play" /><span>Sample</span>
          </button>
          <button
            type="button"
            class="btn btn--ghost btn--sm"
            data-action="clear"
            aria-label="Clear input"
          >
            <Icon name="trash" /><span>Clear</span>
          </button>
        </div>
      </div>
      <textarea
        id="html-entity-encoder-input"
        class="field__textarea"
        placeholder="Type or paste text or HTML…"
        spellcheck="false"
        autocomplete="off"
        autocapitalize="off"
        data-input></textarea>
      <div class="tool__stats" data-input-stats aria-live="off"></div>
    </div>

    <div class="tool__pane">
      <div class="tool__pane-header">
        <label class="tool__pane-title" for="html-entity-encoder-output" data-output-label
          >HTML-encoded</label
        >
        <div class="tool__pane-actions">
          <button type="button" class="btn btn--ghost btn--sm" data-action="copy">
            <Icon name="copy" /><span data-label>Copy</span>
          </button>
        </div>
      </div>
      <textarea
        id="html-entity-encoder-output"
        class="field__textarea"
        placeholder="Output appears here"
        readonly
        spellcheck="false"
        data-output></textarea>
      <div class="tool__stats" data-output-stats aria-live="off"></div>
    </div>
  </div>

  <div class="tool__actions">
    <button type="button" class="btn" data-action="swap">
      <Icon name="swap" /><span>Swap: use output as input</span>
    </button>
    <p class="tool__status" role="status" aria-live="polite" data-status></p>
  </div>
</section>

<script>
  import './client';
</script>
