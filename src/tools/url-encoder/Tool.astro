---
import Icon from '@/components/Icon.astro';

import './tool.scss';
---

<section
  class="tool tool-url-encoder"
  data-tool="url-encoder"
  aria-labelledby="url-encoder-heading"
>
  <h2 id="url-encoder-heading" class="visually-hidden">URL encoder and decoder</h2>

  <div class="tool__options">
    <fieldset class="segmented" data-mode>
      <legend class="visually-hidden">Mode</legend>
      <label class="segmented__option">
        <input type="radio" name="url-mode" value="encode" checked />
        <span>Encode</span>
      </label>
      <label class="segmented__option">
        <input type="radio" name="url-mode" value="decode" />
        <span>Decode</span>
      </label>
    </fieldset>

    <label class="tool-url-encoder__select">
      <span>Style</span>
      <select class="field__select" data-opt="style">
        <option value="component" selected>Component (encodeURIComponent)</option>
        <option value="full">Full URL (encodeURI)</option>
        <option value="form">Form (x-www-form-urlencoded, + for space)</option>
      </select>
    </label>

    <label class="choice" data-decode-only hidden>
      <input type="checkbox" data-opt="stable" />
      Decode until stable
    </label>
  </div>

  <div class="tool__panes">
    <div class="tool__pane">
      <div class="tool__pane-header">
        <label class="tool__pane-title" for="url-encoder-input" data-input-label
          >Text to encode</label
        >
        <div class="tool__pane-actions">
          <button type="button" class="btn btn--ghost btn--sm" data-action="sample">
            <Icon name="play" /><span>Sample</span>
          </button>
          <button
            type="button"
            class="btn btn--ghost btn--sm"
            data-action="clear"
            aria-label="Clear input"
          >
            <Icon name="trash" /><span>Clear</span>
          </button>
        </div>
      </div>
      <textarea
        id="url-encoder-input"
        class="field__textarea"
        placeholder="Type or paste text or a URL…"
        spellcheck="false"
        autocomplete="off"
        autocapitalize="off"
        data-input></textarea>
      <div class="tool__stats" data-input-stats aria-live="off"></div>
    </div>

    <div class="tool__pane">
      <div class="tool__pane-header">
        <label class="tool__pane-title" for="url-encoder-output" data-output-label
          >URL-encoded</label
        >
        <div class="tool__pane-actions">
          <button type="button" class="btn btn--ghost btn--sm" data-action="copy">
            <Icon name="copy" /><span data-label>Copy</span>
          </button>
        </div>
      </div>
      <textarea
        id="url-encoder-output"
        class="field__textarea"
        placeholder="Output appears here"
        readonly
        spellcheck="false"
        data-output></textarea>
      <div class="tool__stats" data-output-stats aria-live="off"></div>
    </div>
  </div>

  <div class="tool__actions">
    <button type="button" class="btn" data-action="swap">
      <Icon name="swap" /><span>Swap: use output as input</span>
    </button>
    <p class="tool__status" role="status" aria-live="polite" data-status></p>
  </div>

  <section
    class="tool-url-encoder__breakdown"
    data-breakdown
    hidden
    aria-labelledby="url-encoder-breakdown-heading"
  >
    <h3 id="url-encoder-breakdown-heading" class="tool-url-encoder__breakdown-title">
      URL breakdown
    </h3>
    <div class="tool-url-encoder__scroll">
      <table class="tool-url-encoder__table">
        <caption class="visually-hidden">Parts of the URL</caption>
        <thead>
          <tr>
            <th scope="col">Part</th>
            <th scope="col" colspan="2">Value</th>
          </tr>
        </thead>
        <tbody data-breakdown-body></tbody>
      </table>
    </div>
  </section>
</section>

<script>
  import './client';
</script>
