---
import Icon from '@/components/Icon.astro';
import ToolCard from '@/components/ToolCard.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { categoryUrl, getPopulatedCategories, getToolsByCategory, tools } from '@/lib/registry';
import { collectionPage, toolItemList, website } from '@/lib/seo';
import { site } from '@/lib/site';

const categories = getPopulatedCategories();

const promises = [
  {
    icon: 'shield' as const,
    title: 'Private by design',
    body: 'Processing happens on your device. We never see what you paste.',
  },
  {
    icon: 'zap' as const,
    title: 'Instant',
    body: 'Static pages and tiny scripts. Tools load in well under a second.',
  },
  {
    icon: 'wifi-off' as const,
    title: 'Works offline',
    body: 'Visit a tool once and it keeps working with no connection.',
  },
];
---

<BaseLayout
  jsonLd={[
    website(),
    collectionPage(site.name, site.description, '/'),
    toolItemList(tools, 'Cuisdev developer tools'),
  ]}
>
  <section class="hero">
    <div class="hero__decor" aria-hidden="true"></div>

    <p class="hero__eyebrow">
      <Icon name="sparkles" />
      {tools.length} free tools · no sign-up
    </p>

    <h1 class="hero__title">
      Developer tools that <span class="hero__accent">respect your data</span>
    </h1>

    <p class="hero__lead">
      {site.tagline} Format, convert, encode and generate — everything runs in your browser, nothing is
      uploaded, and there is nothing to sign up for.
    </p>

    <div class="hero__actions">
      <button type="button" class="btn btn--primary btn--lg" data-palette-open>
        <Icon name="search" /> Find a tool <kbd class="hero__kbd">Ctrl K</kbd>
      </button>
      <a class="btn btn--lg" href="/tools/">Browse all {tools.length} tools</a>
    </div>
  </section>

  <ul class="promises" role="list" aria-label="Why Cuisdev">
    {
      promises.map((promise) => (
        <li class="promises__item">
          <span class="promises__icon">
            <Icon name={promise.icon} />
          </span>
          <span class="promises__text">
            <strong class="promises__title">{promise.title}</strong>
            <span class="promises__body">{promise.body}</span>
          </span>
        </li>
      ))
    }
  </ul>

  {
    categories.map((category) => (
      <section class="section" aria-labelledby={`cat-${category.id}`}>
        <div class="section__header">
          <p class="section__eyebrow">{category.shortName}</p>
          <div class="section__heading-row">
            <h2 class="section__title" id={`cat-${category.id}`}>
              {category.name}
            </h2>
            <a class="section__more" href={categoryUrl(category.id)}>
              All {getToolsByCategory(category.id).length} {category.shortName.toLowerCase()} tools
              <Icon name="arrow-right" />
            </a>
          </div>
          <p class="section__lead">{category.description}</p>
        </div>
        <div class="grid">
          {getToolsByCategory(category.id)
            .slice(0, 8)
            .map((tool) => (
              <ToolCard tool={tool} hideCategory />
            ))}
        </div>
      </section>
    ))
  }
</BaseLayout>
