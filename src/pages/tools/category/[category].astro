---
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import Icon from '@/components/Icon.astro';
import ToolCard from '@/components/ToolCard.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import {
  categoryUrl,
  getCategory,
  getPopulatedCategories,
  getToolsByCategory,
} from '@/lib/registry';
import { breadcrumbs, collectionPage, toolItemList } from '@/lib/seo';
import type { ToolCategoryId } from '@/tools/_types';

export function getStaticPaths() {
  return getPopulatedCategories().map((c) => ({ params: { category: c.id } }));
}

const category = getCategory(Astro.params.category as ToolCategoryId);
const categoryTools = getToolsByCategory(category.id);
const crumbs = [
  { name: 'Home', href: '/' },
  { name: 'Tools', href: '/tools/' },
  { name: category.shortName, href: categoryUrl(category.id) },
];
const description = `${category.description} ${categoryTools.length} free ${category.shortName.toLowerCase()} tools that run privately in your browser — no sign-up, no uploads.`;
---

<BaseLayout
  title={`${category.name} Tools — Free & Online`}
  description={description}
  jsonLd={[
    breadcrumbs(crumbs),
    collectionPage(`${category.name} tools`, description, categoryUrl(category.id)),
    toolItemList(categoryTools, `${category.name} tools`),
  ]}
>
  <div class="stack stack--lg">
    <Breadcrumbs crumbs={crumbs} />

    <header class="stack stack--sm">
      <div class="cluster">
        <span class="card__icon"><Icon name={category.icon} /></span>
        <h1>{category.name} tools</h1>
      </div>
      <p class="section__lead">{category.description}</p>
    </header>

    <div class="grid">
      {categoryTools.map((tool) => <ToolCard tool={tool} hideCategory headingLevel="h2" />)}
    </div>
  </div>
</BaseLayout>
