{
  "ci": {
    "collect": {
      "staticDistDir": "./dist",
      "url": [
        "http://localhost/",
        "http://localhost/tools/",
        "http://localhost/tools/base64/",
        "http://localhost/about/",
        "http://localhost/tools/json-formatter/",
        "http://localhost/blog/",
        "http://localhost/blog/is-base64-encryption/"
      ],
      "numberOfRuns": 3,
      "settings": {
        "preset": "desktop"
      }
    },
    "assert": {
      "assertMatrix": [
        {
          "matchingUrlPattern": ".*",
          "assertions": {
            "categories:performance": [
              "error",
              {
                "minScore": 0.98
              }
            ],
            "categories:accessibility": [
              "error",
              {
                "minScore": 1
              }
            ],
            "categories:best-practices": [
              "error",
              {
                "minScore": 1
              }
            ],
            "categories:seo": [
              "error",
              {
                "minScore": 1
              }
            ],
            "cumulative-layout-shift": [
              "error",
              {
                "maxNumericValue": 0.01
              }
            ],
            "total-blocking-time": [
              "error",
              {
                "maxNumericValue": 100
              }
            ],
            "resource-summary:document:size": [
              "warn",
              {
                "maxNumericValue": 61440
              }
            ],
            "resource-summary:stylesheet:size": [
              "error",
              {
                "maxNumericValue": 61440
              }
            ]
          }
        },
        {
          "matchingUrlPattern": "^http://localhost/blog/",
          "assertions": {
            "resource-summary:script:size": [
              "error",
              {
                "maxNumericValue": 61440
              }
            ]
          }
        },
        {
          "matchingUrlPattern": "^http://localhost/(about/)?$",
          "assertions": {
            "resource-summary:script:size": [
              "error",
              {
                "maxNumericValue": 61440
              }
            ]
          }
        },
        {
          "matchingUrlPattern": "^http://localhost/tools/",
          "assertions": {
            "resource-summary:script:size": [
              "error",
              {
                "maxNumericValue": 614400
              }
            ]
          }
        }
      ]
    },
    "upload": {
      "target": "temporary-public-storage"
    }
  }
}
